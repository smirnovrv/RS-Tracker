   
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ЗаполнитьПоУмолчанию();
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Описание 		= Новый ХранилищеЗначения(ОписаниеДокумент, Новый СжатиеДанных(9));  

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Чат = ТекущийОбъект.Содержание.Получить(); 
	
	тОписаниеДокумент 	= ТекущийОбъект.Описание.Получить();
    ОписаниеДокумент 	= тОписаниеДокумент; 
	
	СформироватьСтрокуНаблюдатели(); 

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	НоваяСтрока = Объект.Наблюдатели.Добавить();
   	НоваяСтрока.Сотрудник = ВыбранноеЗначение; 
		
	СформироватьСтрокуНаблюдатели(); 
		
	Модифицированность = Истина;

КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если Не Объект.ЕстьУведомления И ЗначениеЗаполнено(Объект.Исполнитель) Тогда 
		Структура = Новый Структура; 
		Структура.Вставить("Тема", "Добавлено новое ТЗ");  	
		Структура.Вставить("Тело", СформироватьТекстПисьма("Новое"));
		
		Получатели = ПолучитьПолучателейОповещения(); 
		Если Получатели.Количество() > 0 Тогда 
			Структура.Вставить("Получатели", Получатели);			
			ОтправитьОповещениеНаСервере(Структура);
			
			Объект.ЕстьУведомления  = Истина;
			Записать();		
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти    

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура СтатусПриИзменении(Элемент)  
	
	СтатусБылИзменен = СтатусИзменен();
	
	Если СтатусБылИзменен Тогда
		
		Если Не ОбеспечитьСсылкуОбъекта() Тогда
			Возврат;
		КонецЕсли;
		
		Структура = Новый Структура; 
		Структура.Вставить("Тема", "Изменен статус ТЗ");  	
		Структура.Вставить("Тело", СформироватьТекстПисьма("Статус"));
		
		Получатели = ПолучитьПолучателейОповещения();  
		Если Получатели.Количество() > 0 Тогда 			
			Структура.Вставить("Получатели", Получатели);			
			ОтправитьОповещениеНаСервере(Структура);  
		КонецЕсли;  
		
		ЗаписьРегистраИсторииСтатусовТехническогоЗадания();
	КонецЕсли;
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.рс_СтатусыТехЗаданий.ВРаботу") И СтатусБылИзменен Тогда 
		 Объект.РедактироватьОписание = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьОписаниеПриИзменении(Элемент)
	Элементы.ГруппаОписание.ТолькоПросмотр = Не Объект.РедактироватьОписание;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ДобавитьСообщение(Команда)
	
	ДобавитьСообщение2();
	
	Если Не ОбеспечитьСсылкуОбъекта() Тогда
		Возврат;
	КонецЕсли;
	
	Структура = Новый Структура; 
	Структура.Вставить("Тема", "Добавлен комментарий в ТЗ");  	
	Структура.Вставить("Тело", СформироватьТекстПисьма("Комментарий"));
	
	Получатели = ПолучитьПолучателейОповещения();
	Если Получатели.Количество() > 0 Тогда 		
		Структура.Вставить("Получатели", Получатели);		
		ОтправитьОповещениеНаСервере(Структура);  
	КонецЕсли;
	
	Записать();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНаблюдателя(Команда)
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора",,ЭтаФорма,,,,);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНаблюдателей(Команда)
	ОчиститьНаблюдателейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОснование(Команда)
	ДополнительныеПараметры = Новый Структура;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ДополнительныеПоляПередНачаломДобавленияЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	ОткрытьФорму("ОбщаяФорма.рс_ФормаВыбораОснования",,,,,,ОповещениеОЗакрытии);
КонецПроцедуры

&НаКлиенте
Процедура ТолькоЧтение(Команда)
	Если Элементы.ГруппаШапка.Скрыта() Тогда 
		Элементы.ГруппаШапка.Показать();
	Иначе	
		Элементы.ГруппаШапка.Скрыть();
	КонецЕсли;
	Если Элементы.ГруппаСообщение.Скрыта() Тогда 
		Элементы.ГруппаСообщение.Показать();
	Иначе	
		Элементы.ГруппаСообщение.Скрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОповещение(Команда) 
	
	Если Не ОбеспечитьСсылкуОбъекта() Тогда
		Возврат;
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("Тема"		, "");  
	Структура.Вставить("ТекстПисьма", "");
	ОтправитьОповещениеНаСервере(Структура);   
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
