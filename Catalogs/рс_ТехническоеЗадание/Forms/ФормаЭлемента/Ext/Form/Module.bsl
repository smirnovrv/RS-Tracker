&НаКлиенте
Процедура ДобавитьСообщение2()
	
	массивФС = Новый Массив;
	
	ФС 	= ОписаниеДокумент.ПолучитьФорматированнуюСтроку();	
	массивФС.Добавить(ФС); 
	Если ЗначениеЗаполнено(ФС) Тогда 
		массивФС.Добавить(Символы.ПС);
		массивФС.Добавить(Символы.ПС);   
	КонецЕсли;
	
	СтрокаАвтор = Новый ФорматированнаяСтрока(ПолучитьАвтораИВремя(), Новый Шрифт(,,,,Истина,,),,,);
	массивФС.Добавить(СтрокаАвтор); 
	массивФС.Добавить(Символы.ПС);
	
	ФС = Сообщение.ПолучитьФорматированнуюСтроку(); 
	массивФС.Добавить(ФС); 
	массивФС.Добавить(Символы.ПС);
	
	итСтрокаФС 	= Новый ФорматированнаяСтрока(массивФС);
