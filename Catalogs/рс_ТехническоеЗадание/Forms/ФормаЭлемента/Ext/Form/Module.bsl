&НаСервере
Процедура ЗаписьРегистраИсторииСтатусовТехническогоЗадания() 
	
	НоваяЗапись = РегистрыСведений.РС_ИсторияИзмененияСтатусовТехническогоЗадания.СоздатьМенеджерЗаписи();
	НоваяЗапись.ТехническоеЗадание 	= Объект.Ссылка;
	НоваяЗапись.Статус 				= Объект.Статус; 
	НоваяЗапись.Период 				= ТекущаяДата();
	НоваяЗапись.Пользователь 		= ПараметрыСеанса.ТекущийПользователь;
	НоваяЗапись.Записать(Истина);
	
