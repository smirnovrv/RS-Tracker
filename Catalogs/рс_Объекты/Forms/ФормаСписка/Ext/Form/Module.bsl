
&НаСервере
Процедура КомандаЗаполнитьНаСервере()
	
	Если ЗаполнятьСправочники Тогда
		ЗаполнитьОбъектыМетаданных("Справочники");
	КонецЕсли;
	
	Если ЗаполнятьДокументы Тогда
		ЗаполнитьОбъектыМетаданных("Документы");
	КонецЕсли;
	
	Если ЗаполнятьРегистрыСведений Тогда
		ЗаполнитьОбъектыМетаданных("РегистрыСведений");
	КонецЕсли;
	
	Если ЗаполнятьРегистрыНакопления Тогда
		ЗаполнитьОбъектыМетаданных("РегистрыНакопления");
	КонецЕсли;
	
	Если ЗаполнятьОтчеты Тогда
		ЗаполнитьОбъектыМетаданных("Отчеты");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	КомандаЗаполнитьНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыМетаданных(Имя)
	
	Если Имя = "Справочники" Тогда
		ИмяДляЗапроса = "Справочник";
	ИначеЕсли Имя = "Документы" Тогда
		ИмяДляЗапроса = "Документ";
	ИначеЕсли Имя = "РегистрыСведений" Тогда
		ИмяДляЗапроса = "РегистрСведений";
	ИначеЕсли Имя = "РегистрыНакопления" Тогда
		ИмяДляЗапроса = "РегистрНакопления";
	ИначеЕсли Имя = "Отчеты" Тогда
		ИмяДляЗапроса = "Отчет";
	Иначе
		ИмяДляЗапроса = Неопределено;
	КонецЕсли;
	
	Если ИмяДляЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Метаданное Из Метаданные[Имя] Цикл
		
		КоличествоОбъектов 	= РС_ОбщийМодульСервер.ПолучитьКоличествоОбъектовМетаданных(ИмяДляЗапроса, Метаданное.Имя);
		рс_ВидОбъекта 		= Перечисления.рс_ВидОбъекта[ИмяДляЗапроса];
		ПоискОбъект 		= РС_ОбщийМодульСервер.НайтиОбъектРС(рс_ВидОбъекта, Метаданное.Имя);
		
		Если ЗначениеЗаполнено(ПоискОбъект) Тогда
			Продолжить;
		КонецЕсли;
		
		Структура = Новый Структура;
		Структура.Вставить("Индентификатор", Метаданное.Имя);
		Структура.Вставить("Наименование", Метаданное.Синоним);
		Структура.Вставить("Вид", рс_ВидОбъекта);
		Структура.Вставить("КоличествоОбъектов", КоличествоОбъектов);
		Структура.Вставить("тВид", ИмяДляЗапроса);
		
		Попытка
			РС_ОбщийМодульСервер.СоздатьОбъектРС(Структура);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон("Ошибка при загрузке %1 ""%2"": %3", Имя, Метаданное.Имя, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КоличествоНаСервере(Знач ВыделенныеСтроки)
	
	Для Каждого Ссылка Из ВыделенныеСтроки Цикл
		
		ОбъектРС = Ссылка.ПолучитьОбъект();
		Если ОбъектРС = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДляЗапроса = XMLСтрока(ОбъектРС.Вид);
		ОбъектРС.КоличествоВБД = РС_ОбщийМодульСервер.ПолучитьКоличествоОбъектовМетаданных(ИмяДляЗапроса, ОбъектРС.Индентификатор);
		ОбъектРС.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Количество(Команда)
	
	ВыделенныеСтроки = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ВыделенныеСтроки.Добавить(ВыделеннаяСтрока);
	КонецЦикла;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоНаСервере(ВыделенныеСтроки);
	Элементы.Список.Обновить();
	
КонецПроцедуры
