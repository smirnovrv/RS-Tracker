
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	ТекущийОбъект.Описание 		= Новый ХранилищеЗначения(ОписаниеДокумент, Новый СжатиеДанных(9));	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ОписаниеДокумент 	= ТекущийОбъект.Описание.Получить(); 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыНаСервере()
	
	ИмяДляЗапроса 		= Строка(Объект.Вид);
	
	КоличествоОбъектов 	=  РС_ОбщийМодульСервер.ПолучитьКоличествоОбъектовМетаданных(ИмяДляЗапроса, Объект.Индентификатор);
	
	Структура = Новый Структура;
	Структура.Вставить("Индентификатор"		, Объект.Индентификатор);
	Структура.Вставить("Наименование"		, Объект.Наименование);  
	Структура.Вставить("Вид" 				, Объект.Вид);			
	Структура.Вставить("КоличествоОбъектов"	, КоличествоОбъектов); 
	Структура.Вставить("тВид"				, ИмяДляЗапроса);
	Структура.Вставить("ОбъектСсылка"		, Объект.Ссылка);
	
	РС_ОбщийМодульСервер.ЗаполнитьРеквизитыРС(Структура);

КонецПроцедуры

&НаСервере
Функция СоздатьТабличнуюЧастьРС(Знач ИмяТЧ)
	НовыйЭлемент = Справочники.рс_ТабличныеЧасти.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ИмяТЧ;
	НовыйЭлемент.Записать();
	Возврат НовыйЭлемент.Ссылка;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРеквизиты(Команда)
	
	ЗаполнитьРеквизитыНаСервере(); 
	
	Прочитать(); 
	
	Модифицированность = Истина; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	УстановитьВидимость();
КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимость()
	Если Объект.Вид = ПредопределенноеЗначение("Перечисление.рс_ВидОбъекта.Документ") 
		Или Объект.Вид = ПредопределенноеЗначение("Перечисление.рс_ВидОбъекта.Справочник") Тогда
		Элементы.ГруппаРеквизиты.Видимость 					= Истина;
		Элементы.рс_РеквизитыВидРеквизита.Видимость 		= Ложь;
		Элементы.рс_Реквизитырс_ТабличнаяЧасть.Видимость	= Истина;
	ИначеЕсли Объект.Вид = ПредопределенноеЗначение("Перечисление.рс_ВидОбъекта.РегистрНакопления") 
		Или Объект.Вид = ПредопределенноеЗначение("Перечисление.рс_ВидОбъекта.РегистрСведений") Тогда 
		Элементы.ГруппаРеквизиты.Видимость 					= Истина;
		Элементы.рс_РеквизитыВидРеквизита.Видимость 		= Истина;
		Элементы.рс_Реквизитырс_ТабличнаяЧасть.Видимость 	= Ложь;
	Иначе  
		Элементы.ГруппаРеквизиты.Видимость = Ложь;	  
	КонецЕсли;   	
КонецПроцедуры	

&НаКлиенте
Процедура ВидПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВерсиюКонфигурацииНаСервере()
	Объект.ВерсияКонфигурации 	= Метаданные.Имя + " " + Метаданные.Версия; 
	Модифицированность 			= Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВерсиюКонфигурации(Команда)
	ОбновитьВерсиюКонфигурацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КоличествоНаСервере()
	ИмяДляЗапроса = XMLСтрока(Объект.Вид);
	Объект.КоличествоВБД = РС_ОбщийМодульСервер.ПолучитьКоличествоОбъектовМетаданных(ИмяДляЗапроса, Объект.Индентификатор);
КонецПроцедуры

&НаКлиенте
Процедура Количество(Команда)
	КоличествоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "СтраницаТехническиеЗадания" Тогда                  
		  Список.Параметры.УстановитьЗначениеПараметра("рс_Объект", Объект.Ссылка); 
	КонецЕсли;	
КонецПроцедуры	