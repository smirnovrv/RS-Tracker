
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьПредставлениеРазмера();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПоместитьДанныеФайлаВоВременноеХранилище(ТекущийОбъект);
	ОбновитьПредставлениеРазмера();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ЭтоАдресВременногоХранилища(АдресДанныхФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресДанныхФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.ДанныеФайла = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
	ТекущийОбъект.ФайлЗагружен = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавитьФайлЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДанныеФайлаНаСервере(Адрес, ВыбранноеИмяФайла);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайл(Команда)
	
	Адрес = ПолучитьАдресФайлаНаСервере();
	Если ПустаяСтрока(Адрес) Тогда
		Сообщить("Файл не добавлен.");
		Возврат;
	КонецЕсли;
	
	ПолучитьФайл(Адрес, Объект.ИмяФайла, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	Адрес = ПолучитьАдресФайлаНаСервере();
	Если ПустаяСтрока(Адрес) Тогда
		Сообщить("Файл не добавлен.");
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = КаталогВременныхФайлов() + Объект.ИмяФайла;
	Если ПолучитьФайл(Адрес, ИмяВременногоФайла, Ложь) Тогда
		НачатьЗапускПриложения(Новый ОписаниеОповещения("ПослеЗапускаПриложения", ЭтотОбъект), ИмяВременногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗапускаПриложения(КодВозврата, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФайлаНаСервере(Адрес, ВыбранноеИмяФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Если ДвоичныеДанные = Неопределено Тогда
		Сообщить("Не удалось прочитать выбранный файл.");
		Возврат;
	КонецЕсли;
	
	ФайлИнфо = Новый Файл(ВыбранноеИмяФайла);
	
	АдресДанныхФайла = Адрес;
	Объект.ИмяФайла = ФайлИнфо.Имя;
	Объект.Расширение = СтрЗаменить(ФайлИнфо.Расширение, ".", "");
	Объект.Размер = ДвоичныеДанные.Размер();
	Объект.ФайлЗагружен = Истина;
	Объект.ДатаДобавления = ТекущаяДатаСеанса();
	
	Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Description) Тогда
		Объект.Description = ФайлИнфо.ИмяБезРасширения;
	КонецЕсли;
	
	ОбновитьПредставлениеРазмера();
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьДанныеФайлаВоВременноеХранилище(ТекущийОбъект)
	
	АдресДанныхФайла = "";
	
	Если ТипЗнч(ТекущийОбъект.ДанныеФайла) <> Тип("ХранилищеЗначения") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = ТекущийОбъект.ДанныеФайла.Получить();
	Если ДанныеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресДанныхФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресФайлаНаСервере()
	
	Если ЭтоАдресВременногоХранилища(АдресДанныхФайла) Тогда
		Возврат АдресДанныхФайла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДанныеФайла");
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеФайла = Хранилище.Получить();
	Если ДанныеФайла = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	АдресДанныхФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	Возврат АдресДанныхФайла;
	
КонецФункции

&НаСервере
Процедура ОбновитьПредставлениеРазмера()
	
	Если Объект.Размер = 0 Тогда
		РазмерПредставление = "";
		Возврат;
	КонецЕсли;
	
	Если Объект.Размер < 1024 Тогда
		РазмерПредставление = Формат(Объект.Размер, "ЧН=0") + " байт";
	ИначеЕсли Объект.Размер < 1024 * 1024 Тогда
		РазмерПредставление = Формат(Объект.Размер / 1024, "ЧДЦ=1") + " КБ";
	Иначе
		РазмерПредставление = Формат(Объект.Размер / (1024 * 1024), "ЧДЦ=1") + " МБ";
	КонецЕсли;
	
КонецПроцедуры
