
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = ТекущаяДатаСеанса();
	ТолькоДокументы = Истина;
	Свернуть = Истина;
	Создание = Истина;
	Изменение = Истина;
	Проведение = Истина;
	ОтменаПроведения = Истина;
	Удаление = Истина;
	Лимит = 5000;
	
	ЗаполнитьСписокПользователей();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ТекстОшибки = ЗаполнитьНаСервере();
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаСервере()
	
	Журнал.Очистить();
	Найдено = 0;
	Элементы.ЖурналДата.Видимость = Не Свернуть;
	Элементы.ЖурналДанные.Видимость = Не Свернуть;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат "Укажите период.";
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		Возврат "Начало периода больше окончания.";
	КонецЕсли;
	
	События = СобытияОтбора();
	Если События.Количество() = 0 Тогда
		Возврат "Выберите хотя бы одно событие.";
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", НачалоДня(ДатаНачала));
	Отбор.Вставить("ДатаОкончания", КонецДня(ДатаОкончания));
	Отбор.Вставить("Событие", События);
	
	ИмяПользователяОтбор = СокрЛП(Пользователь);
	Если Не ПустаяСтрока(ИмяПользователяОтбор) Тогда
		ИменаПользователей = Новый Массив;
		ИменаПользователей.Добавить(ИмяПользователяОтбор);
		Отбор.Вставить("Пользователь", ИменаПользователей);
	КонецЕсли;
	
	ФрагментВида = "";
	УстановитьОтборМетаданных(Отбор, ФрагментВида);
	
	ТаблицаЖурнала = Новый ТаблицаЗначений;
	Колонки = "Дата,ИмяПользователя,ПредставлениеПриложения,ПредставлениеСобытия,Метаданные,ПредставлениеМетаданных,ПредставлениеДанных";
	Попытка
		Если Лимит > 0 Тогда
			ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, Колонки, "", Лимит);
		Иначе
			ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, Колонки);
		КонецЕсли;
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ФрагментПриложения = НРег(СокрЛП(Приложение));
	ФрагментВидаНРег = НРег(ФрагментВида);
	Для Каждого СтрокаЖурнала Из ТаблицаЖурнала Цикл
		Если Не СтрокаПодходит(СтрокаЖурнала, ФрагментПриложения, ФрагментВидаНРег) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Журнал.Добавить();
		НоваяСтрока.Дата = СтрокаЖурнала.Дата;
		НоваяСтрока.Пользователь = ИмяПользователяСтроки(СтрокаЖурнала.ИмяПользователя);
		НоваяСтрока.Приложение = СтрокаЖурнала.ПредставлениеПриложения;
		НоваяСтрока.Событие = СтрокаЖурнала.ПредставлениеСобытия;
		НоваяСтрока.ИмяМетаданных = СтрокаЖурнала.Метаданные;
		НоваяСтрока.ПредставлениеМетаданных = СтрокаЖурнала.ПредставлениеМетаданных;
		НоваяСтрока.Данные = СтрокаЖурнала.ПредставлениеДанных;
		НоваяСтрока.Количество = 1;
	КонецЦикла;
	
	Если Свернуть Тогда
		ТаблицаИтогов = Журнал.Выгрузить();
		ТаблицаИтогов.Свернуть("Пользователь,Приложение,Событие,ИмяМетаданных,ПредставлениеМетаданных", "Количество");
		Журнал.Загрузить(ТаблицаИтогов);
	КонецЕсли;
	
	Журнал.Сортировать("Пользователь,ИмяМетаданных,Событие");
	Найдено = Журнал.Количество();
	Возврат "";
	
КонецФункции

&НаСервере
Функция СобытияОтбора()
	
	События = Новый Массив;
	Если Создание Тогда
		События.Добавить("_$Data$_.New");
	КонецЕсли;
	Если Изменение Тогда
		События.Добавить("_$Data$_.Update");
	КонецЕсли;
	Если Проведение Тогда
		События.Добавить("_$Data$_.Post");
	КонецЕсли;
	Если ОтменаПроведения Тогда
		События.Добавить("_$Data$_.Unpost");
	КонецЕсли;
	Если Удаление Тогда
		События.Добавить("_$Data$_.Delete");
	КонецЕсли;
	Возврат События;
	
КонецФункции

&НаСервере
Процедура УстановитьОтборМетаданных(Отбор, ФрагментВида)
	
	ФрагментВида = "";
	ТекстВида = СокрЛП(ВидОбъекта);
	Если Не ПустаяСтрока(ТекстВида) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТекстВида);
		Если ОбъектМетаданных = Неопределено И СтрНайти(ТекстВида, ".") = 0 Тогда
			ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("Документ." + ТекстВида);
		КонецЕсли;
		Если ОбъектМетаданных <> Неопределено Тогда
			МетаданныеОтбора = Новый Массив;
			МетаданныеОтбора.Добавить(ОбъектМетаданных);
			Отбор.Вставить("Метаданные", МетаданныеОтбора);
			Возврат;
		КонецЕсли;
		ФрагментВида = ТекстВида;
	КонецЕсли;
	
	Если ТолькоДокументы Тогда
		МетаданныеОтбора = Новый Массив;
		Для Каждого ОписаниеДокумента Из Метаданные.Документы Цикл
			МетаданныеОтбора.Добавить(ОписаниеДокумента);
		КонецЦикла;
		Отбор.Вставить("Метаданные", МетаданныеОтбора);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтрокаПодходит(СтрокаЖурнала, ФрагментПриложения, ФрагментВида)
	
	Если Не ПустаяСтрока(ФрагментПриложения)
		И СтрНайти(НРег(Строка(СтрокаЖурнала.ПредставлениеПриложения)), ФрагментПриложения) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ФрагментВида) Тогда
		ТекстМетаданных = НРег(Строка(СтрокаЖурнала.Метаданные) + " " + Строка(СтрокаЖурнала.ПредставлениеМетаданных));
		Если СтрНайти(ТекстМетаданных, ФрагментВида) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ИмяПользователяСтроки(Имя)
	
	Если ПустаяСтрока(СокрЛП(Строка(Имя))) Тогда
		Возврат "(не указан)";
	КонецЕсли;
	Возврат Строка(Имя);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокПользователей()
	
	Попытка
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			Элементы.Пользователь.СписокВыбора.Добавить(ПользовательИБ.Имя);
		КонецЦикла;
		Элементы.Пользователь.СписокВыбора.СортироватьПоЗначению();
	Исключение
	КонецПопытки;
	
КонецПроцедуры
