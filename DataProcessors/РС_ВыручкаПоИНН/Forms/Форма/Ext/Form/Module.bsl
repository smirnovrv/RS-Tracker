&НаКлиенте
Процедура Получить(Команда)
	
	Результат = ПолучитьНаСервере();
	Если Не ПустаяСтрока(Результат.Текст) Тогда
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНаСервере()
	
	Наименование = "";
	Выручка = 0;
	Год = "";
	
	ИННОрганизации = ЦифрыСтроки(ИНН);
	Если СтрДлина(ИННОрганизации) <> 10 И СтрДлина(ИННОрганизации) <> 12 Тогда
		Возврат Новый Структура("Текст", "ИНН должен содержать 10 или 12 цифр.");
	КонецЕсли;
	
	Попытка
		Поиск = РезультатЗапросаВФНС("/advanced-search/organizations/search?query=" + ИННОрганизации + "&page=0&size=20");
	Исключение
		Возврат Новый Структура("Текст", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Организация = ЭлементМассива(ЗначениеСоответствия(Поиск, "content"), 0);
	Если Организация = Неопределено Тогда
		Возврат Новый Структура("Текст", "По ИНН " + ИННОрганизации + " организация не найдена.");
	КонецЕсли;
	
	Наименование = НаименованиеОрганизации(Организация);
	Идентификатор = ИдентификаторОрганизации(ЗначениеСоответствия(Организация, "id"));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Новый Структура("Текст", "Сервис не вернул идентификатор организации.");
	КонецЕсли;
	
	Попытка
		Отчетность = РезультатЗапросаВФНС("/nbo/organizations/" + Идентификатор + "/bfo/");
	Исключение
		Возврат Новый Структура("Текст", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Отчет = ЭлементМассива(Отчетность, 0);
	Если Отчет = Неопределено Тогда
		Возврат Новый Структура("Текст", "Бухгалтерская отчетность по организации не найдена.");
	КонецЕсли;
	
	ВыручкаТысяч = Выручка2110(Отчет);
	Если ВыручкаТысяч = Неопределено Тогда
		Возврат Новый Структура("Текст", "В отчетности нет выручки по строке 2110.");
	КонецЕсли;
	
	Выручка = ВыручкаТысяч * 1000;
	Год = СокрЛП(Строка(ЗначениеСоответствия(Отчет, "period")));
	
	Возврат Новый Структура("Текст", "");
	
КонецФункции

&НаСервере
Функция РезультатЗапросаВФНС(Адрес)
	
	Возврат РС_ОбщийМодульСервер.РезультатЗапросаБоНалог(Адрес);
	
КонецФункции

&НаСервере
Функция Выручка2110(Отчет)
	
	Коррекция = ЭлементМассива(ЗначениеСоответствия(Отчет, "typeCorrections"), 0);
	ФинансовыйРезультат = ЗначениеСоответствия(ЗначениеСоответствия(Коррекция, "correction"), "financialResult");
	ВыручкаТысяч = ЗначениеСоответствия(ФинансовыйРезультат, "current2110");
	Если ВыручкаТысяч = Неопределено Тогда
		ВыручкаТысяч = ЗначениеСоответствия(Отчет, "gainSum");
	КонецЕсли;
	Если ВыручкаТысяч = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЧислоИзJSON(ВыручкаТысяч);
	
КонецФункции

&НаСервере
Функция НаименованиеОрганизации(Организация)
	
	Для Каждого Ключ Из СтрРазделить("shortName,fullName,name", ",", Ложь) Цикл
		Значение = ЗначениеСоответствия(Организация, Ключ);
		Если Значение <> Неопределено И Не ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
			Возврат СокрЛП(Строка(Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИдентификаторОрганизации(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	
	Текст = СтрЗаменить(СокрЛП(Строка(Значение)), Символы.НПП, "");
	Возврат СтрЗаменить(Текст, " ", "");
	
КонецФункции

&НаСервере
Функция ЧислоИзJSON(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Текст = СтрЗаменить(СокрЛП(Строка(Значение)), Символы.НПП, "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Текст);
	
КонецФункции

&НаСервере
Функция ЗначениеСоответствия(Данные, Ключ)
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные.Получить(Ключ);
	
КонецФункции

&НаСервере
Функция ЭлементМассива(Данные, Индекс)
	
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Индекс < 0 Или Индекс >= Данные.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные[Индекс];
	
КонецФункции

&НаСервере
Функция ЦифрыСтроки(Значение)
	
	Цифры = "";
	Текст = СокрЛП(Строка(Значение));
	Длина = СтрДлина(Текст);
	Для Индекс = 1 По Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Цифры;
	
КонецФункции
