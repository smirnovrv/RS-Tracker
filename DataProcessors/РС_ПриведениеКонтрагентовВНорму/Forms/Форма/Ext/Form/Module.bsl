&НаСервере
Процедура ИННСодержитЦифрыНаСервере()
	
	Выборка = Справочники.РС_КонтрагентыОбмен.Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ПометкаУдаления Тогда 
			Продолжить; 
		КонецЕсли;
		ПоискЦифр = ИННСодержитНеЦифры(Выборка.ИНН);
		Если ПоискЦифр = 0 Тогда 
			УстановитьПометкуУдаления(Выборка);	
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИННСодержитНеЦифры(ИНН)
	текстЦифры = "1234567890";
	Для к=1 по 12 Цикл
		п = 0;
		текСимвол = Сред(ИНН,к,1);
		п = СтрНайти(текстЦифры, текСимвол);	
	КонецЦикла;
	Возврат п;
КонецФункции

