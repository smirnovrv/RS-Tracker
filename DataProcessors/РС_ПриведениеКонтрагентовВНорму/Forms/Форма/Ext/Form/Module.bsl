&НаСервере
Процедура Дубли_НаименованиеИННКПП()
	
	Табл.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РС_КонтрагентыОбмен.Наименование КАК Наименование,
		|	РС_КонтрагентыОбмен.ИНН КАК ИНН,
		|	РС_КонтрагентыОбмен.КПП КАК КПП,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РС_КонтрагентыОбмен.Ссылка) КАК Ссылка
		|ПОМЕСТИТЬ ВТ_контр
		|ИЗ
		|	Справочник.РС_КонтрагентыОбмен КАК РС_КонтрагентыОбмен
		|
		|СГРУППИРОВАТЬ ПО
		|	РС_КонтрагентыОбмен.Наименование,
		|	РС_КонтрагентыОбмен.ИНН,
		|	РС_КонтрагентыОбмен.КПП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_контр.Наименование КАК Наименование,
		|	ВТ_контр.ИНН КАК ИНН,
		|	ВТ_контр.КПП КАК КПП,
		|	ВТ_контр.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_контр КАК ВТ_контр
		|ГДЕ
		|	ВТ_контр.Ссылка > 1";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Табл.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

