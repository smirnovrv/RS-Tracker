
&НаСервере
Процедура НетИНН_нетКИНаСервере()
	
	Выборка = Справочники.РС_КонтрагентыОбмен.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ПометкаУдаления Тогда 
			Продолжить;
		КонецЕсли;
		
		СправочникОбъект = Выборка.ПолучитьОбъект();
		СправочникОбъект.Наименование 		= СокрЛП(СправочникОбъект.Наименование);
		СправочникОбъект.НаименованиеПолное = СокрЛП(СправочникОбъект.НаименованиеПолное);
		
		Если Не ЗначениеЗаполнено(Выборка.ИНН) И Выборка.КонтактнаяИнформация.Количество() = 0 Тогда 
			 СправочникОбъект.ПометкаУдаления = Истина;
		КонецЕсли;	
		
		СправочникОбъект.Записать();  
		
	КонецЦикла;
	
КонецПроцедуры

