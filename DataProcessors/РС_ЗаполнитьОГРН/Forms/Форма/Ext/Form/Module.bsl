
&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РС_Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ОГРН = """"
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.Недействует
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Наименование";
	Если КоличествоЗаписей > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ " + Формат(КоличествоЗаписей, "ЧГ=0"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	ТабРезультата.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнение(Команда)
	
	Текст = ВыполнитьЗаполнениеНаСервере();
	ПоказатьПредупреждение(, Текст);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗаполнениеНаСервере()
	
	Записано = 0;
	Пропущено = 0;
	
	Для Каждого СтрокаТаблицы Из ТабРезультата Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Ссылка) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		КонтрагентОбъект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
		Если КонтрагентОбъект = Неопределено Тогда
			Сообщить("Пропущен " + Строка(СтрокаТаблицы.Ссылка) + ": элемент не найден.");
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		ИНН = ЦифрыСтроки(КонтрагентОбъект.ИНН);
		Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
			Сообщить("Пропущен " + Строка(СтрокаТаблицы.Ссылка) + ": ИНН должен содержать 10 или 12 цифр.");
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОГРН = РС_ОбщийМодульСервер.ОГРНПоИННИзЕГРЮЛ(ИНН);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Если СтрНайти(ТекстОшибки, "проверку") > 0 Тогда
				Возврат "Записано: " + Записано + ". Пропущено: " + Пропущено + ". " + ТекстОшибки;
			КонецЕсли;
			Сообщить("Пропущен " + Строка(СтрокаТаблицы.Ссылка) + ": " + ТекстОшибки);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецПопытки;
		
		Если ПустаяСтрока(ОГРН) Тогда
			Сообщить("Пропущен " + Строка(СтрокаТаблицы.Ссылка) + ": по ИНН " + ИНН + " в ЕГРЮЛ ОГРН не найден.");
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		КонтрагентОбъект.ОГРН = ОГРН;
		Попытка
			КонтрагентОбъект.Записать();
			Записано = Записано + 1;
		Исключение
			Сообщить("Не записан " + Строка(СтрокаТаблицы.Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Пропущено = Пропущено + 1;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат "Записано: " + Записано + ". Пропущено: " + Пропущено + ".";
	
КонецФункции

&НаСервере
Функция ЦифрыСтроки(Значение)
	
	Цифры = "";
	Текст = СокрЛП(Строка(Значение));
	Длина = СтрДлина(Текст);
	Для Индекс = 1 По Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Цифры;
	
КонецФункции
