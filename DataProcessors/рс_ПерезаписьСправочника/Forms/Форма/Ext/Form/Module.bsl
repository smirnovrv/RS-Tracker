
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокВыбора = Элементы.ИмяСправочника.СписокВыбора;
	Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
		Представление = МетаданныеСправочника.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = МетаданныеСправочника.Имя;
		КонецЕсли;
		СписокВыбора.Добавить(МетаданныеСправочника.Имя, Представление + " (" + МетаданныеСправочника.Имя + ")");
	КонецЦикла;
	СписокВыбора.СортироватьПоПредставлению();
	
КонецПроцедуры

&НаКлиенте
Процедура Перезаписать(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяСправочника) Тогда
		ПоказатьПредупреждение(, "Выберите справочник.");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаписатьЗавершение", ЭтотОбъект);
	ТекстВопроса = "Перезаписать все элементы справочника """ + ИмяСправочника + """?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаписатьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПерезаписатьНаСервере();
	ПоказатьПредупреждение(, Результат);
	
КонецПроцедуры

&НаСервере
Функция ПерезаписатьНаСервере()
	
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат "Справочник не найден: " + ИмяСправочника;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + МетаданныеСправочника.Имя + " КАК Спр";
	Если Не ВключаяПомеченныеНаУдаление Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	НЕ Спр.ПометкаУдаления";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Записано = 0;
	Ошибок = 0;
	ТекстОшибок = "";
	
	Пока Выборка.Следующий() Цикл
		ОбъектСправочника = Выборка.Ссылка.ПолучитьОбъект();
		Если ОбъектСправочника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если БезОбработчиковЗаписи Тогда
			ОбъектСправочника.ОбменДанными.Загрузка = Истина;
		КонецЕсли;
		
		Попытка
			ОбъектСправочника.Записать();
			Записано = Записано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Если Ошибок <= 20 Тогда
				ТекстОшибок = ТекстОшибок + Символы.ПС
					+ Строка(Выборка.Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
	ТекстРезультата = "Записано: " + Записано + ". Ошибок: " + Ошибок + ".";
	Если Ошибок > 20 Тогда
		ТекстРезультата = ТекстРезультата + " Показаны первые 20.";
	КонецЕсли;
	
	Возврат ТекстРезультата + ТекстОшибок;
	
КонецФункции
