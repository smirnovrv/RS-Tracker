Функция ПроверкаСеанса(лкИмя, ДопустимоеКоличество)Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		лк_ВсеСеансы = ПолучитьСеансыИнформационнойБазы();
		
		лк_ТабСеансовПользователя = Новый ТаблицаЗначений;
		лк_ТабСеансовПользователя.Колонки.Добавить("Пользователь");
		лк_ТабСеансовПользователя.Колонки.Добавить("КоличествоОткрытыхСеансов");
		
		лк_ИмяПользователя = СокрЛП(?(ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь),
		ПараметрыСеанса.ТекущийПользователь,
		ПараметрыСеанса.ТекущийВнешнийПользователь));
		
		Для Каждого Эл_овп_Сеансы Из лк_ВсеСеансы Цикл
			Если СокрЛП(Эл_овп_Сеансы.Пользователь.ПолноеИмя) = лк_ИмяПользователя 
				И ЗначениеЗаполнено(Эл_овп_Сеансы.IPАдресКлиента)  Тогда
				НовСтр_овп_ТабСеансовПользователя = лк_ТабСеансовПользователя.Добавить();
				НовСтр_овп_ТабСеансовПользователя.Пользователь = СокрЛП(Эл_овп_Сеансы.Пользователь);
				НовСтр_овп_ТабСеансовПользователя.КоличествоОткрытыхСеансов = 1;
			КонецЕсли;	
		КонецЦикла;
		
		лк_ТабСеансовПользователя.Свернуть("Пользователь", "КоличествоОткрытыхСеансов");
		
		Если  лк_ТабСеансовПользователя.Количество()>0 Тогда 
			Если лк_ТабСеансовПользователя.Получить(0).КоличествоОткрытыхСеансов > ДопустимоеКоличество Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;

КонецФункции    

Процедура ЗаполнитьКИ(Приемник, Источник)  Экспорт
		
	СпрОбъект = Приемник.ПолучитьОбъект();
	
	СпрОбъект.КонтактнаяИнформация.Очистить();
	
	Для Каждого СтрокаКИ Из Источник.КонтактнаяИнформация Цикл  
		НоваяСтрока = СпрОбъект.КонтактнаяИнформация.Добавить(); 
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКИ);
	
		тВид = Справочники.РС_ВидыКонтактнойИнформации.НайтиПоНаименованию(СтрокаКИ.Вид.Наименование);
		Если Не ЗначениеЗаполнено(тВид) Тогда
			тВид = СоздатьпростойСправочник("РС_ВидыКонтактнойИнформации", СтрокаКИ.Вид.Наименование);
		КонецЕсли;
		НоваяСтрока.Вид = тВид;
		
		Если СтрокаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда 
			ЗначенияПолей = СтрокаКИ.Значение;
			Если ЗначенияПолей = "" Тогда 
				ЗначенияПолей = СтрокаКИ.ЗначенияПолей;
			КонецЕсли; 
			Если Метаданные.Имя = "УправлениеХолдингом" Или Метаданные.Имя = "БухгалтерияПредприятия" Тогда   
				Попытка
					ИмяМодуля 	= "УправлениеКонтактнойИнформациейСлужебный"; 	
					Модуль 		= Вычислить(ИмяМодуля);	
					Адрес 		= Модуль.JSONВКонтактнуюИнформациюПоПолям(ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Адрес); 
					
					тСтрана = Справочники.РС_Страны.НайтиПоНаименованию(Адрес.country);
					Если Не ЗначениеЗаполнено(тСтрана) Тогда 
						тСтрана = СоздатьпростойСправочник("РС_Страны", Адрес.country);
					КонецЕсли;                               
					НоваяСтрока.Страна = тСтрана; 
					
					тРегион = Справочники.РС_Регионы.НайтиПоНаименованию(Адрес.area);
					Если Не ЗначениеЗаполнено(тРегион) Тогда 
						тРегион = СоздатьпростойСправочник("РС_Регионы", Адрес.area);
					КонецЕсли;                               
					НоваяСтрока.Регион = тРегион; 
					
					тГород = Справочники.РС_Города.НайтиПоНаименованию(Адрес.city);
					Если Не ЗначениеЗаполнено(тГород) Тогда 
						тГород = СоздатьпростойСправочник("РС_Города", Адрес.city);
					КонецЕсли;                               
					НоваяСтрока.Город = тГород;  
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;	
	
	СпрОбъект.Записать();
	
КонецПроцедуры

Функция СоздатьпростойСправочник(Спр, Наименование) 
	
    тЭлемент = Справочники[Спр].СоздатьЭлемент();
	тЭлемент.Наименование = Наименование;
	тЭлемент.Записать();
	
	Возврат тЭлемент.Ссылка;
	
КонецФункции 

Функция ДобавитьЭлементОКВЭД2(Код, Имя) Экспорт 
	
	НовыйЭлемент = Справочники.КлассификаторОКВЭД2.СоздатьЭлемент();
	НовыйЭлемент.Код 				= Код;	
	НовыйЭлемент.Наименование   	= Имя;
	НовыйЭлемент.НаименованиеПолное = Имя;
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции  

Процедура ПроверкаКонтрагентовНаСервере(ПараметрыОтчета) Экспорт   
	Попытка
		РезультатПроверки 		= Обработки.ПроверкаКонтрагента.ДанныеКарточкиКонтрагента(ПараметрыОтчета);
		МассивДополнительные 	= РезультатПроверки.ДанныеПроверкиКонтрагента.КарточкаВидыДеятельности.Дополнительные; 	
		ОсновнойВид 			= РезультатПроверки.ДанныеПроверкиКонтрагента.КарточкаВидыДеятельности.ОсновнойВид;
		
		поискОснОКВЭД2 = Справочники.КлассификаторОКВЭД2.НайтиПоКоду(ОсновнойВид.Код);
		
		Если НЕ ЗначениеЗаполнено(поискОснОКВЭД2) Тогда	
			поискОснОКВЭД2 = ДобавитьЭлементОКВЭД2(ОсновнойВид.Код, ОсновнойВид.Наименование);	
		КонецЕсли;  
		
		КонтрагентОбъект = ПараметрыОтчета.Контрагент.ПолучитьОбъект();
		
		КонтрагентОбъект.РС_ОКВЭД2 = поискОснОКВЭД2;
		
		Если МассивДополнительные.Количество() > 0 Тогда 
			КонтрагентОбъект.РС_ДополнительныеОКВЭД.Очистить();		
			Для Каждого СтрДополнительно Из МассивДополнительные Цикл;
				НоваяСтрока = КонтрагентОбъект.РС_ДополнительныеОКВЭД.Добавить();
				НоваяСтрока.КодОКВЭД 			=  СтрДополнительно.Код;
				НоваяСтрока.НаименованиеПолное 	=  СтрДополнительно.Наименование;
				
				поискОКВЭД2 = Справочники.КлассификаторОКВЭД2.НайтиПоКоду(СтрДополнительно.Код);
				
				Если Не ЗначениеЗаполнено(поискОКВЭД2) Тогда 
					поискОКВЭД2 = ДобавитьЭлементОКВЭД2(СтрДополнительно.Код, СтрДополнительно.Наименование);	
				КонецЕсли;
				
				НоваяСтрока.ОКВЭД2 = поискОКВЭД2;
			КонецЦикла;
		КонецЕсли; 
		
		КонтрагентОбъект.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры 

Функция ПолучитьВыборкуКонтрагентов() Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(Контрагенты.НаименованиеПолное КАК СТРОКА(1000)) КАК НаименованиеПолное,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

#Область ПоискСозданияОбъектаРС  

Функция НайтиОбъектРС(Вид, Имя) Экспорт
	
	ПоискОбъект = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	рс_Объекты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.рс_Объекты КАК рс_Объекты
		|ГДЕ
		|	рс_Объекты.Вид = &Вид
		|	И рс_Объекты.Индентификатор = &Имя
		|	И рс_Объекты.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Вид"	, Вид);
	Запрос.УстановитьПараметр("Имя"	, Имя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоискОбъект = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат ПоискОбъект;
	
КонецФункции 

Функция СоздатьОбъектРС(Структура)  Экспорт 
	 
	НовОбъект = Справочники.рс_Объекты.СоздатьЭлемент();	
	НовОбъект.Индентификатор 	= Структура.Индентификатор;
	НовОбъект.Наименование  	= Структура.Наименование; 
	НовОбъект.Вид            	= Структура.Вид;
	НовОбъект.КоличествоВБД     = Структура.КоличествоОбъектов;
	Если Структура.КоличествоОбъектов > 0 Тогда 
		НовОбъект.Используется      = Истина;
	КонецЕсли;
	
	ИмяТипа 					= рс_ОбщийМодульСервер.ИмяТипаМетаданныхДляФормы(Строка(Структура.Вид));
   	ПолноеИмя 					= ИмяТипа + "." + Структура.Индентификатор;  
	
	ИмяКоллекции 				= ИмяКоллекцииМетаданныхПоВиду(Структура.тВид);
	Структура.Вставить("тВид"	, ИмяКоллекции);
	
	НовОбъект.ОбъектБД          = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", ПолноеИмя);
	
	НовОбъект.Записать();
	
	Структура.Вставить("ОбъектСсылка"	, НовОбъект.Ссылка);
		
	ЗаполнитьРеквизитыРС(Структура);
		
	Возврат НовОбъект.Ссылка;
	
КонецФункции

//Структура
//Вид					Справочник	ПеречислениеСсылка.рс_ВидОбъекта
//Индентификатор		"ВЕТИСПрисоединенныеФайлы"	Строка
//КоличествоОбъектов	0	Число
//Наименование			"Протокол обмена ВетИС"	Строка 
//ОбъектСсылка			Протокол обмена ВетИС	СправочникСсылка.рс_Объекты
//тВид					"Справочники"	Строка
//
Процедура ЗаполнитьРеквизитыРС(Структура) Экспорт
	
	Если Строка(Структура.Вид) = "Регистр сведений" Или Строка(Структура.Вид) = "Регистр накопления" Тогда 
		ЗаполнитьРеквизитыРегистраРС(Структура);
	ИначеЕсли Строка(Структура.Вид) = "Справочник" Или Строка(Структура.Вид) = "Документ" Тогда 	
		ЗаполнитьРеквизитыОбъектаРС(Структура.ОбъектСсылка);
	КонецЕсли;
		
КонецПроцедуры	

Процедура ЗаполнитьРеквизитыРегистраРС(Структура) 

	МетаданныеОбъекта = Метаданные[Структура.тВид][Структура.Индентификатор];
	
	НовОбъект = Структура.ОбъектСсылка.ПолучитьОбъект();
	Структура.Вставить("Табл" , НовОбъект.рсРеквизиты);
	
	ДобавитьСтрокиРеквизитовПоКоллекции(Структура, МетаданныеОбъекта.Измерения, Неопределено, Перечисления.рс_ВидРеквизита.Измерение);
	ДобавитьСтрокиРеквизитовПоКоллекции(Структура, МетаданныеОбъекта.Ресурсы, Неопределено, Перечисления.рс_ВидРеквизита.Ресурс);
	ДобавитьСтрокиРеквизитовПоКоллекции(Структура, МетаданныеОбъекта.Реквизиты, Неопределено, Перечисления.рс_ВидРеквизита.Реквизит);
	
	НовОбъект.Записать();
	
КонецПроцедуры

Процедура ДобавитьСтрокиРеквизитовПоКоллекции(Структура, КоллекцияРеквизитов, ТабличнаяЧастьСсылка, ВидРеквизита)
	
	Для Каждого Метаданное Из КоллекцияРеквизитов Цикл
		НовСтрока 					= Структура.Табл.Добавить(); 
		СтрокаТипа 					= СтрокаТипаИзОписанияТипа(Метаданное.Тип);
		НовСтрока.Имя 				= ПолучитьСсылкуРеквизита(Метаданное.Имя, Метаданное.Синоним, СтрокаТипа);
		
		Если ЗначениеЗаполнено(НовСтрока.Имя) Тогда 
			 НовСтрока.ТипРеквизита = НовСтрока.Имя.Тип;
		 КонецЕсли;
		 
		НовСтрока.ВидРеквизита 		= ВидРеквизита;
		
		Если Метаданное.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда 
			НовСтрока.Обязательный = Истина;
		КонецЕсли;  
		
		поискИОМ = Неопределено;
		Попытка 
			поискИОМ = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя",СтрокаТипа); 
		Исключение
		КонецПопытки;
		
		Если ЗначениеЗаполнено(поискИОМ) Тогда 
			НовСтрока.ТипОбъектовМетаданных = поискИОМ;
		КонецЕсли;
		
		Если ТабличнаяЧастьСсылка <> Неопределено Тогда
			НовСтрока.рсТабличнаяЧасть = ТабличнаяЧастьСсылка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыОбъектаРС(СпрСсылка) 
	
	СпрОбъект = СпрСсылка.ПолучитьОбъект();
	
	СпрОбъект.рсРеквизиты.Очистить(); 
		
	ИмяКоллекции = ИмяКоллекцииМетаданныхПоВиду(СпрОбъект.Вид);
	
	Структура = Новый Структура; 
	Структура.Вставить("тВид"	, ИмяКоллекции);
	Структура.Вставить("ИД"		, СпрОбъект.Индентификатор);
	Структура.Вставить("Табл"	, СпрОбъект.рсРеквизиты);
	Структура.Вставить("ТЧ"		, Неопределено);

	ЗаполнитьРеквизиты(Структура); 
	
	Для Каждого ТабЧасть Из Метаданные[Структура.тВид][Структура.ИД].ТабличныеЧасти Цикл 
		ИмяТЧ 		= ТабЧасть.Имя;
		ТабЧасть 	= Справочники.рс_ТабличныеЧасти.НайтиПоНаименованию(ИмяТЧ);
		
		Если Не ЗначениеЗаполнено(ТабЧасть) Тогда 
			ТабЧасть = СоздатьТабличныеЧастиРС(ИмяТЧ);
		КонецЕсли;
		
		Структура.Вставить("ТЧ"		, ТабЧасть);
		Структура.Вставить("ИмяТЧ"	, ИмяТЧ);

		ЗаполнитьРеквизиты(Структура);
	КонецЦикла;	
			
	СпрОбъект.Записать();
		
КонецПроцедуры

Процедура ЗаполнитьРеквизиты(Структура) 

	МетаданныеОбъекта = Метаданные[Структура.тВид][Структура.ИД];
	
	Если Структура.ТЧ = Неопределено Тогда
		КоллекцияРеквизитов = МетаданныеОбъекта.Реквизиты;
		ТабличнаяЧастьСсылка = Неопределено;
	Иначе
		ИмяТЧ = Структура.ИмяТЧ;
		МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаданныеТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		КоллекцияРеквизитов = МетаданныеТЧ.Реквизиты;
		ТабличнаяЧастьСсылка = Структура.ТЧ;
	КонецЕсли;
	
	Для Каждого Метаданное Из КоллекцияРеквизитов Цикл
		НовСтрока 		= Структура.Табл.Добавить();		
		
		СтрокаТипа 		= СтрокаТипаИзОписанияТипа(Метаданное.Тип);
		НовСтрока.Имя 	= ПолучитьСсылкуРеквизита(Метаданное.Имя, Метаданное.Синоним, СтрокаТипа);  //Реквизит
		Если ЗначениеЗаполнено(НовСтрока.Имя) Тогда 
			 НовСтрока.ТипРеквизита = НовСтрока.Имя.Тип;
		КонецЕсли;	
		
		Если Метаданное.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда 
			НовСтрока.Обязательный = Истина;
		КонецЕсли;  
		
		Попытка 
			поискИОМ = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя",СтрокаТипа); 
		Исключение
		КонецПопытки;
		
		Если ЗначениеЗаполнено(поискИОМ) Тогда 
			НовСтрока.ТипОбъектовМетаданных = поискИОМ;
		КонецЕсли;
		
