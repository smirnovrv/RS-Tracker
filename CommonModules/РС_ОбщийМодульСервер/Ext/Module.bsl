Функция ОГРНПоИННИзЕГРЮЛ(ИНН) Экспорт
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Соединение = Новый HTTPСоединение("egrul.nalog.ru", 443, , , , 30, ЗащищенноеСоединение);
	
	Запрос = Новый HTTPЗапрос("/");
	ЗаполнитьЗаголовкиЕГРЮЛ(Запрос);
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
	Тело = "vyp3CaptchaToken=&page=&query=" + ИНН + "&region=&PreventChromeAutocomplete=";
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ДанныеЗапроса = ДанныеОтветаЕГРЮЛ(Ответ);
	Если ТребуетсяКапчаЕГРЮЛ(ДанныеЗапроса) Тогда
		ВызватьИсключение "Сервис ЕГРЮЛ запросил проверку. Повторите запрос позже.";
	КонецЕсли;
	
	Токен = СтрокаЗначенияJSON(ДанныеЗапроса.Получить("t"));
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Сервис ЕГРЮЛ не вернул результат поиска.";
	КонецЕсли;
	
	Куки = КукиОтвета(Ответ);
	Строки = Неопределено;
	Для НомерПопытки = 1 По 3 Цикл
		ЗапросПоиска = Новый HTTPЗапрос("/search-result/" + Токен);
		ЗаполнитьЗаголовкиЕГРЮЛ(ЗапросПоиска);
		Если Не ПустаяСтрока(Куки) Тогда
			ЗапросПоиска.Заголовки.Вставить("Cookie", Куки);
		КонецЕсли;
		
		ОтветПоиска = Соединение.Получить(ЗапросПоиска);
		ДанныеПоиска = ДанныеОтветаЕГРЮЛ(ОтветПоиска);
		Если ТребуетсяКапчаЕГРЮЛ(ДанныеПоиска) Тогда
			ВызватьИсключение "Сервис ЕГРЮЛ запросил проверку. Повторите запрос позже.";
		КонецЕсли;
		
		Строки = ДанныеПоиска.Получить("rows");
		Если ТипЗнч(Строки) = Тип("Массив") И Строки.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если НомерПопытки < 3 Тогда
			ПаузаМиллисекунд(400);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого СтрокаРезультата Из Строки Цикл
		Если ТипЗнч(СтрокаРезультата) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Если ЦифрыСтроки(СтрокаЗначенияJSON(СтрокаРезультата.Получить("i"))) <> ИНН Тогда
			Продолжить;
		КонецЕсли;
		
		ОГРН = ЦифрыСтроки(СтрокаЗначенияJSON(СтрокаРезультата.Получить("o")));
		Если ЭтоОГРН(ОГРН) Тогда
			Возврат ОГРН;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура ЗаполнитьЗаголовкиЕГРЮЛ(Запрос)
	
	Запрос.Заголовки.Вставить("User-Agent", "Mozilla/5.0");
	Запрос.Заголовки.Вставить("Accept", "application/json, text/javascript, */*; q=0.01");
	Запрос.Заголовки.Вставить("Accept-Language", "ru-RU,ru;q=0.9");
	Запрос.Заголовки.Вставить("X-Requested-With", "XMLHttpRequest");
	Запрос.Заголовки.Вставить("Origin", "https://egrul.nalog.ru");
	Запрос.Заголовки.Вставить("Referer", "https://egrul.nalog.ru/");
	
КонецПроцедуры

Функция ДанныеОтветаЕГРЮЛ(Ответ)
	
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Сервис ЕГРЮЛ вернул код " + Ответ.КодСостояния + ".";
	КонецЕсли;
	
	Текст = СокрЛП(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Если ПустаяСтрока(Текст) Или Лев(Текст, 1) <> "{" Тогда
		ВызватьИсключение "Сервис ЕГРЮЛ вернул неожиданный ответ.";
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Сервис ЕГРЮЛ вернул неожиданный ответ.";
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ТребуетсяКапчаЕГРЮЛ(Данные)
	
	Капча = Данные.Получить("captchaRequired");
	Возврат Капча = Истина Или НРег(СтрокаЗначенияJSON(Капча)) = "true";
	
КонецФункции

Функция КукиОтвета(Ответ)
	
	ЗначениеКуки = Ответ.Заголовки.Получить("Set-Cookie");
	Если ЗначениеКуки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Части = СтрРазделить(Строка(ЗначениеКуки), ";", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Части[0]);
	
КонецФункции

Функция СтрокаЗначенияJSON(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Функция ЦифрыСтроки(Значение)
	
	Цифры = "";
	Текст = СокрЛП(Строка(Значение));
	Длина = СтрДлина(Текст);
	Для Индекс = 1 По Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Цифры;
	
КонецФункции

Процедура ПаузаМиллисекунд(Миллисекунды)
	
	Момент = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунды;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Момент Цикл
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоОГРН(Цифры)
	
	Длина = СтрДлина(Цифры);
	Если Длина = 13 Тогда
		Контроль = Число(Лев(Цифры, 12)) % 11 % 10;
	ИначеЕсли Длина = 15 Тогда
		Контроль = Число(Лев(Цифры, 14)) % 13 % 10;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Число(Прав(Цифры, 1)) = Контроль;
	
КонецФункции

Функция РезультатЗапросаБоНалог(Адрес) Экспорт
	
	Сервер = "bo.nalog.gov.ru";
	Путь = Адрес;
	Куки = "";
	Соединение = СоединениеБоНалог(Сервер);
	Ответ = Неопределено;
	
	Для НомерПерехода = 1 По 5 Цикл
		Запрос = Новый HTTPЗапрос(Путь, ЗаголовкиЗапросаБоНалог(Куки));
		Ответ = Соединение.Получить(Запрос);
		Куки = ОбъединитьКукиБоНалог(Куки, КукиОтветаБоНалог(Ответ));
		
		Если ЭтоПереадресацияБоНалог(Ответ.КодСостояния) Тогда
			АдресПерехода = ЗаголовокОтветаБоНалог(Ответ, "Location");
			Если ПустаяСтрока(АдресПерехода) Тогда
				ВызватьИсключение "Сервис bo.nalog.gov.ru вернул код " + Ответ.КодСостояния + " без адреса перехода.";
			КонецЕсли;
			РазобратьАдресПереходаБоНалог(АдресПерехода, Сервер, Путь);
			Соединение = СоединениеБоНалог(Сервер);
			Продолжить;
		КонецЕсли;
		
		Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
			ВызватьИсключение "Сервис bo.nalog.gov.ru вернул код " + Ответ.КодСостояния + ".";
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
	Если Ответ = Неопределено Или ЭтоПереадресацияБоНалог(Ответ.КодСостояния) Тогда
		ВызватьИсключение "Сервис bo.nalog.gov.ru превысил число переадресаций.";
	КонецЕсли;
	
	Текст = СокрЛП(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "Сервис bo.nalog.gov.ru вернул пустой ответ.";
	КонецЕсли;
	Если Лев(Текст, 1) <> "{" И Лев(Текст, 1) <> "[" Тогда
		ВызватьИсключение "Сервис bo.nalog.gov.ru вернул страницу вместо данных.";
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	
	Возврат Данные;
	
КонецФункции

Функция СоединениеБоНалог(Сервер)
	
	Возврат Новый HTTPСоединение(Сервер, 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
	
КонецФункции

Функция ЗаголовкиЗапросаБоНалог(Куки)
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept-Language", "ru,en;q=0.9,en-GB;q=0.8,en-US;q=0.7");
	Заголовки.Вставить("Accept", "application/json, text/plain, */*");
	Заголовки.Вставить("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36");
	Заголовки.Вставить("Referer", "https://bo.nalog.gov.ru/");
	Если Не ПустаяСтрока(Куки) Тогда
		Заголовки.Вставить("Cookie", Куки);
	КонецЕсли;
	
	Возврат Заголовки;
	
КонецФункции

Функция ЭтоПереадресацияБоНалог(КодСостояния)
	
	Возврат КодСостояния = 301 Или КодСостояния = 302 Или КодСостояния = 303
		Или КодСостояния = 307 Или КодСостояния = 308;
	
КонецФункции

Функция ЗаголовокОтветаБоНалог(Ответ, Имя)
	
	Значение = Ответ.Заголовки.Получить(Имя);
	Если Значение = Неопределено Тогда
		Значение = Ответ.Заголовки.Получить(НРег(Имя));
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Функция КукиОтветаБоНалог(Ответ)
	
	ЗначениеКуки = ЗаголовокОтветаБоНалог(Ответ, "Set-Cookie");
	Если ПустаяСтрока(ЗначениеКуки) Тогда
		Возврат "";
	КонецЕсли;
	
	Части = СтрРазделить(ЗначениеКуки, ";", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Части[0]);
	
КонецФункции

Функция ОбъединитьКукиБоНалог(Текущие, Новые)
	
	Если ПустаяСтрока(Новые) Тогда
		Возврат Текущие;
	КонецЕсли;
	Если ПустаяСтрока(Текущие) Тогда
		Возврат Новые;
	КонецЕсли;
	
	Имя = "";
	Позиция = СтрНайти(Новые, "=");
	Если Позиция > 1 Тогда
		Имя = Лев(Новые, Позиция - 1);
	КонецЕсли;
	Если Не ПустаяСтрока(Имя) И СтрНайти(Текущие, Имя + "=") > 0 Тогда
		Возврат Текущие;
	КонецЕсли;
	
	Возврат Текущие + "; " + Новые;
	
КонецФункции

Процедура РазобратьАдресПереходаБоНалог(АдресПерехода, Сервер, Путь)
	
	Адрес = СокрЛП(АдресПерехода);
	Если СтрНачинаетсяС(Адрес, "//") Тогда
		Адрес = "https:" + Адрес;
	КонецЕсли;
	
	Если СтрНачинаетсяС(НРег(Адрес), "http://") Или СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
		Сервер = СтруктураURI.Хост;
		Путь = СтруктураURI.ПутьНаСервере;
		Если Не СтрНачинаетсяС(Путь, "/") Тогда
			Путь = "/" + Путь;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(Адрес, "/") Тогда
		Путь = Адрес;
	Иначе
		Путь = "/" + Адрес;
	КонецЕсли;
	
КонецПроцедуры
